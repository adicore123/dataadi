# MongoDB Atlas connection string (server-side only, never NEXT_PUBLIC_).
# Get it from Atlas → Connect → Drivers.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"

# Secret used to sign the vault_session cookie (random 32-byte hex:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET="MY_AUTH_SECRET"

# Shared secret guarding the anonymous /api/pending-shares escrow bridge
# used by the Android APK (ShareSinkActivity must send the same value).
SHARE_SECRET="MY_SHARE_SECRET"
