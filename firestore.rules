rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: PhotoAlbum
    function isValidPhotoAlbum(data) {
      return data.keys().hasAll(['ownerId', 'name', 'createdAtIso', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'createdAtIso', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.createdAtIso is string
        && data.createdAtIso.size() >= 1
        && data.createdAtIso.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: VaultItem
    function isValidVaultItem(data) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'module',
          'albumId',
          'albumName',
          'createdAtIso',
          'formattedDate',
          'formattedTime',
          'fileName',
          'fileSize',
          'mimeType',
          'dataUrl',
          'durationSec',
          'notes',
          'source',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'title',
          'module',
          'albumId',
          'albumName',
          'createdAtIso',
          'formattedDate',
          'formattedTime',
          'fileName',
          'fileSize',
          'mimeType',
          'dataUrl',
          'durationSec',
          'notes',
          'source',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.module is string
        && (data.module == 'documents' || data.module == 'photos' || data.module == 'recordings')
        && data.albumId is string
        && data.albumId.size() <= 128
        && data.albumName is string
        && data.albumName.size() <= 120
        && data.createdAtIso is string
        && data.createdAtIso.size() >= 1
        && data.createdAtIso.size() <= 64
        && data.formattedDate is string
        && data.formattedDate.size() >= 1
        && data.formattedDate.size() <= 32
        && data.formattedTime is string
        && data.formattedTime.size() >= 1
        && data.formattedTime.size() <= 32
        && data.fileName is string
        && data.fileName.size() >= 1
        && data.fileName.size() <= 255
        && data.fileSize is number
        && data.fileSize >= 0
        && data.fileSize <= 50000000
        && data.mimeType is string
        && data.mimeType.size() >= 1
        && data.mimeType.size() <= 128
        && data.dataUrl is string
        && data.dataUrl.size() <= 780000
        && data.durationSec is number
        && data.durationSec >= 0
        && data.durationSec <= 86400
        && data.notes is string
        && data.notes.size() <= 1000
        && data.source is string
        && (data.source == 'upload' || data.source == 'mobile-share' || data.source == 'voice-recorder')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: /photo_albums/{albumId}
    match /photo_albums/{albumId} {
      allow get: if isVerifiedUser()
        && isValidId(albumId)
        && existing().ownerId == request.auth.uid;

      allow list: if isVerifiedUser()
        && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(albumId)
        && isValidPhotoAlbum(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(albumId)
        && isValidPhotoAlbum(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().createdAtIso == existing().createdAtIso
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']);

      allow delete: if isVerifiedUser()
        && isValidId(albumId)
        && existing().ownerId == request.auth.uid;
    }

    // Collection: /vault_items/{itemId}
    match /vault_items/{itemId} {
      allow get: if isVerifiedUser()
        && isValidId(itemId)
        && existing().ownerId == request.auth.uid;

      allow list: if isVerifiedUser()
        && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(itemId)
        && isValidVaultItem(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(itemId)
        && isValidVaultItem(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().createdAtIso == existing().createdAtIso
        && incoming().formattedDate == existing().formattedDate
        && incoming().formattedTime == existing().formattedTime
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'module',
          'albumId',
          'albumName',
          'notes',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(itemId)
        && existing().ownerId == request.auth.uid;
    }
  }
}
